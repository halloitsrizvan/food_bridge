# Copy to .env.local and fill in. Never commit real values.

# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. The real "service_role" secret (NOT the publishable key). Used for signup and the seed script.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase: Connect -> ORMs / connection string
# DATABASE_URL = transaction pooler (port 6543), append ?pgbouncer=true&connection_limit=1  (runtime)
DATABASE_URL=
# DIRECT_URL = session pooler or direct connection (port 5432)                              (migrations)
DIRECT_URL=

# Protects /api/v1/cron/tick (Vercel sends it as a Bearer token). Any long random string.
CRON_SECRET=

# Public base URL (http://localhost:3000 locally, your Vercel URL in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: email notifications (in-app notifications always work)
RESEND_API_KEY=
MAIL_FROM=FoodBridge <onboarding@resend.dev>
# Optional: send every email to this one inbox (Resend sandbox / demo safety)
MAIL_REDIRECT_TO=

# Optional: photo upload (field is hidden when these are empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
